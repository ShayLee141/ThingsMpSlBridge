<Project Sdk="Godot.NET.Sdk/4.5.1">
  <!-- 本机路径配置，见 local.props.example；该文件不入库 -->
  <Import Project="local.props" Condition="Exists('local.props')" />
  <PropertyGroup>
    <AssemblyName>ThingsMpSlBridge</AssemblyName>
    <RootNamespace>ThingsMpSlBridge</RootNamespace>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <!-- 优先级：local.props > 环境变量 STS2_GAME_DIR -->
    <Sts2GameDir Condition="'$(Sts2GameDir)' == '' and '$(STS2_GAME_DIR)' != ''">$(STS2_GAME_DIR)</Sts2GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="build\**\*.cs" />
    <Reference Include="0Harmony">
      <HintPath>$(Sts2GameDir)\data_sts2_windows_x86_64\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(Sts2GameDir)\data_sts2_windows_x86_64\sts2.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="RequireSts2GameDir" BeforeTargets="ResolveAssemblyReferences" Condition="'$(Sts2GameDir)' == ''">
    <Error Text="Sts2GameDir 未设置。请把 local.props.example 复制为 local.props 并填上游戏安装目录，或用 -p:Sts2GameDir=&quot;...&quot; / 环境变量 STS2_GAME_DIR 传入。" />
  </Target>
</Project>
